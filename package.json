{
  "name": "w3pinho",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev --turbopack",
    "prebuild": "node scripts/generate-search-index.js",
    "build": "next build --turbopack",
    "start": "next start",
    "lint": "eslint",
    "remove:lesson": "bash ./scripts/remove_lesson.sh",
    "add:ids": "node ./scripts/generate-lesson-ids.js",
    "test": "firebase emulators:exec --project=demo-test-project \"vitest run\"",
    "test:watch": "firebase emulators:exec --project=demo-test-project \"vitest\"",
    "test:coverage": "firebase emulators:exec --project=demo-test-project \"vitest run --coverage\"",
    "test:unit": "vitest run tests/unit",
    "test:integration": "firebase emulators:exec --project=demo-test-project \"vitest run tests/integration\"",
    "test:components": "vitest run tests/components",
    "test:e2e": "firebase emulators:exec --project=demo-test-project \"npx playwright test\"",
    "test:e2e:ui": "firebase emulators:exec --project=demo-test-project \"npx playwright test --ui\""
  },
  "dependencies": {
    "@react-email/components": "^1.0.12",
    "@react-pdf/renderer": "^4.5.1",
    "firebase": "^12.9.0",
    "firebase-admin": "^13.7.0",
    "fuse.js": "^7.3.0",
    "gray-matter": "^4.0.3",
    "next": "^16.1.6",
    "next-auth": "^5.0.0-beta.30",
    "react": "^19.2.4",
    "react-dom": "^19.2.4",
    "react-email": "^5.2.10",
    "react-markdown": "^10.1.0",
    "react-syntax-highlighter": "^16.1.1",
    "rehype-raw": "^7.0.0",
    "rehype-sanitize": "^6.0.0",
    "remark-gfm": "^4.0.1",
    "resend": "^6.10.0"
  },
  "devDependencies": {
    "@eslint/eslintrc": "^3",
    "@faker-js/faker": "^10.5.0",
    "@playwright/test": "^1.61.1",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.2",
    "@testing-library/user-event": "^14.6.1",
    "eslint": "^9",
    "eslint-config-next": "15.5.3",
    "firebase-tools": "^13.29.0",
    "jsdom": "^29.1.1",
    "vitest": "^3.2.3"
  }
